<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Property definitions -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="APP_NAME" value="portfolio-showcase"/>
    
    <!-- Console appender pattern for development -->
    <property name="CONSOLE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n"/>
    
    <!-- File appender pattern for production -->
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Development Profile -->
    <springProfile name="dev">
        <!-- Root logger -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        
        <!-- Application loggers -->
        <logger name="com.portfolio.showcase" level="DEBUG"/>
        <logger name="com.portfolio.showcase.controller" level="DEBUG"/>
        <logger name="com.portfolio.showcase.service" level="DEBUG"/>
        <logger name="com.portfolio.showcase.repository" level="DEBUG"/>
        
        <!-- Spring Framework -->
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        
        <!-- Hibernate SQL logging -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    </springProfile>

    <!-- Production Profile -->
    <springProfile name="prod">
        <!-- Root logger -->
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        
        <!-- Application loggers -->
        <logger name="com.portfolio.showcase" level="INFO"/>
        <logger name="com.portfolio.showcase.controller" level="INFO"/>
        <logger name="com.portfolio.showcase.service" level="INFO"/>
        <logger name="com.portfolio.showcase.repository" level="WARN"/>
        
        <!-- Spring Framework -->
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        
        <!-- Hibernate - minimal logging in production -->
        <logger name="org.hibernate" level="WARN"/>
    </springProfile>

    <!-- Default profile (when no profile is active) -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.portfolio.showcase" level="INFO"/>
    </springProfile>

</configuration>
