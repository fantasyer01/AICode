# constants.py.example - Template for application constants
# Copy this file to constants.py and fill in your actual values

# DeepSeek API配置（直接在这里填写你的API密钥）
DEEPSEEK_API_KEY = "your_deepseek_api_key_here"

# Flask配置
SECRET_KEY = "your_secret_key_here"

# 拼音功能配置
ENABLE_PINYIN = False  # 是否启用拼音功能，True-启用，False-禁用

# 流式返回配置
DEFAULT_STREAM_MODE = True  # 是否默认启用流式返回，True-启用，False-禁用

# 流式日志输出配置
IS_OUTPUT_STREAM_LOG = True  # 是否输出流式返回日志，True-输出，False-不输出

# 其他配置
DEBUG = True
